{
  "manifest_version": 3,
  "name": "Task Out",
  "version": "2.1.0",
  "description": "按项目集中查看网页与兼容 Agent 会话，支持可配置来源、进展、归档和模型辅助整理。",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Task Out",
    "default_icon": {
      "16": "icons/task-out16.png",
      "32": "icons/task-out32.png",
      "48": "icons/task-out48.png"
    }
  },
  "icons": {
    "16": "icons/task-out16.png",
    "32": "icons/task-out32.png",
    "48": "icons/task-out48.png",
    "128": "icons/task-out128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
